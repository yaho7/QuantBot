{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantBot Agent host performance",
  "$ref": "#/$defs/batch",
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_cores": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 65536
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "cpu_cores",
        "memory_bytes"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "binding_key": {
          "type": "string",
          "pattern": "^qbh_[A-Za-z0-9_-]{43}$"
        },
        "capacity": {
          "$ref": "#/$defs/resources"
        },
        "process_budget": {
          "$ref": "#/$defs/resources"
        }
      },
      "required": [
        "host_id",
        "binding_key"
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_usage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "memory_available_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "swap_used_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disk_available_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "swap_pressure": {
          "type": "boolean"
        }
      },
      "minProperties": 1
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_cores_used": {
          "type": "number",
          "minimum": 0,
          "maximum": 65536
        },
        "rss_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "thread_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uptime_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "minProperties": 1
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "sample_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "process": {
          "$ref": "#/$defs/process"
        }
      },
      "required": [
        "record_id",
        "observed_at",
        "sample_duration_ms"
      ],
      "anyOf": [
        {
          "required": [
            "host"
          ]
        },
        {
          "required": [
            "process"
          ]
        }
      ]
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 250,
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      },
      "required": [
        "records"
      ]
    }
  }
}
