{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantbot.local/schemas/report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "observedAt", "data"],
  "properties": {
    "id": {"$ref": "#/$defs/key"},
    "kind": {
      "enum": ["status", "connection", "portfolio", "position", "order", "fill", "equity", "performance", "metric", "ohlcv", "signal", "risk", "alert", "log"]
    },
    "observedAt": {"$ref": "#/$defs/stamp"},
    "data": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "status"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/status"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "connection"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/connection"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "portfolio"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/portfolio"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "position"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/position"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "order"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/order"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "fill"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/fill"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "equity"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/equity"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "performance"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/performance"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "metric"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/metric"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "ohlcv"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/ohlcv"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "signal"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/signal"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "risk"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/risk"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "alert"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/alert"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "log"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/log"}}}
    }
  ],
  "$defs": {
    "key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,95}$"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]{0,23})(\\.[0-9]{1,18})?$"},
    "currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,9}$"},
    "stamp": {"type": "integer", "minimum": 1, "maximum": 253402300799999},
    "severity": {"enum": ["debug", "info", "warning", "error", "critical"]},
    "message": {"type": "string", "minLength": 1, "maxLength": 4000},
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "currency", "equity"],
      "properties": {
        "accountId": {"$ref": "#/$defs/key"},
        "currency": {"$ref": "#/$defs/currency"},
        "equity": {"$ref": "#/$defs/decimal"},
        "cash": {"$ref": "#/$defs/decimal"},
        "available": {"$ref": "#/$defs/decimal"},
        "margin": {"$ref": "#/$defs/decimal"},
        "dailyPnl": {"$ref": "#/$defs/decimal"},
        "totalPnl": {"$ref": "#/$defs/decimal"}
      }
    },
    "positionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "positionId", "symbol", "side", "quantity"],
      "properties": {
        "accountId": {"$ref": "#/$defs/key"},
        "positionId": {"$ref": "#/$defs/key"},
        "symbol": {"$ref": "#/$defs/key"},
        "side": {"enum": ["long", "short", "flat"]},
        "quantity": {"$ref": "#/$defs/decimal"},
        "entryPrice": {"$ref": "#/$defs/decimal"},
        "markPrice": {"$ref": "#/$defs/decimal"},
        "unrealizedPnl": {"$ref": "#/$defs/decimal"},
        "currency": {"$ref": "#/$defs/currency"}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["starting", "running", "paused", "stopped", "error"]},
        "message": {"$ref": "#/$defs/message"},
        "startedAt": {"$ref": "#/$defs/stamp"},
        "riskLocked": {"type": "boolean"},
        "allowEntry": {"type": "boolean"}
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brokerConnected"],
      "properties": {
        "brokerConnected": {"type": "boolean"},
        "message": {"$ref": "#/$defs/message"},
        "authorizationExpiresAt": {"$ref": "#/$defs/stamp"}
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounts"],
      "properties": {"accounts": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/account"}}}
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions"],
      "properties": {
        "positions": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/positionItem"}},
        "source": {"enum": ["strategy", "broker"]}
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "orderId", "symbol", "side", "status", "quantity"],
      "properties": {
        "accountId": {"$ref": "#/$defs/key"},
        "orderId": {"$ref": "#/$defs/key"},
        "symbol": {"$ref": "#/$defs/key"},
        "side": {"enum": ["buy", "sell"]},
        "status": {"enum": ["new", "open", "partially_filled", "filled", "cancelled", "rejected", "expired"]},
        "quantity": {"$ref": "#/$defs/decimal"},
        "price": {"$ref": "#/$defs/decimal"},
        "filledQuantity": {"$ref": "#/$defs/decimal"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "fillId", "orderId", "symbol", "side", "quantity", "price"],
      "properties": {
        "accountId": {"$ref": "#/$defs/key"},
        "fillId": {"$ref": "#/$defs/key"},
        "orderId": {"$ref": "#/$defs/key"},
        "symbol": {"$ref": "#/$defs/key"},
        "side": {"enum": ["buy", "sell"]},
        "quantity": {"$ref": "#/$defs/decimal"},
        "price": {"$ref": "#/$defs/decimal"},
        "fee": {"$ref": "#/$defs/decimal"},
        "currency": {"$ref": "#/$defs/currency"},
        "realizedPnl": {"$ref": "#/$defs/decimal"}
      }
    },
    "equity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "currency", "value"],
      "properties": {
        "accountId": {"$ref": "#/$defs/key"},
        "currency": {"$ref": "#/$defs/currency"},
        "value": {"$ref": "#/$defs/decimal"},
        "drawdown": {"$ref": "#/$defs/decimal"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "currency"],
      "properties": {
        "accountId": {"$ref": "#/$defs/key"},
        "currency": {"$ref": "#/$defs/currency"},
        "dailyPnl": {"$ref": "#/$defs/decimal"},
        "totalPnl": {"$ref": "#/$defs/decimal"},
        "returnPct": {"$ref": "#/$defs/decimal"},
        "drawdown": {"$ref": "#/$defs/decimal"},
        "sharpe": {"$ref": "#/$defs/decimal"},
        "winRate": {"$ref": "#/$defs/decimal"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"$ref": "#/$defs/key"},
        "value": {"$ref": "#/$defs/decimal"},
        "accountId": {"$ref": "#/$defs/key"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 40},
        "label": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "ohlcv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "intervalSeconds", "open", "high", "low", "close", "volume"],
      "properties": {
        "symbol": {"$ref": "#/$defs/key"},
        "intervalSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "open": {"$ref": "#/$defs/decimal"},
        "high": {"$ref": "#/$defs/decimal"},
        "low": {"$ref": "#/$defs/decimal"},
        "close": {"$ref": "#/$defs/decimal"},
        "volume": {"$ref": "#/$defs/decimal"}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name", "direction"],
      "properties": {
        "symbol": {"$ref": "#/$defs/key"},
        "name": {"$ref": "#/$defs/key"},
        "direction": {"enum": ["buy", "sell", "long", "short", "flat", "hold"]},
        "strength": {"$ref": "#/$defs/decimal"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/key"},
        "severity": {"$ref": "#/$defs/severity"},
        "message": {"$ref": "#/$defs/message"},
        "locked": {"type": "boolean"},
        "symbol": {"$ref": "#/$defs/key"},
        "dedupKey": {"$ref": "#/$defs/key"}
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/key"},
        "severity": {"$ref": "#/$defs/severity"},
        "message": {"$ref": "#/$defs/message"},
        "dedupKey": {"$ref": "#/$defs/key"}
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message"],
      "properties": {
        "severity": {"$ref": "#/$defs/severity"},
        "message": {"$ref": "#/$defs/message"},
        "logger": {"$ref": "#/$defs/key"}
      }
    }
  }
}
