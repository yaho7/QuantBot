{
  "openapi": "3.1.0",
  "info": {
    "title": "QuantBot Agent API",
    "version": "3.0.0",
    "description": "The version field identifies the QuantBot release. Agent paths are unversioned."
  },
  "security": [
    {
      "AgentBearer": []
    }
  ],
  "paths": {
    "/api/agent/session": {
      "post": {
        "summary": "Open an Agent session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../internal/server/schemas/agent.json#/$defs/session"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Accepted"
          },
          "default": {
            "description": "See AGENT_PROTOCOL.md for error and retry behavior"
          }
        }
      }
    },
    "/api/agent/heartbeat": {
      "put": {
        "summary": "Renew Agent presence",
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "default": {
            "description": "See AGENT_PROTOCOL.md for error and retry behavior"
          }
        }
      }
    },
    "/api/agent/capabilities": {
      "put": {
        "summary": "Register a complete capability revision",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../internal/server/schemas/agent.json#/$defs/capabilities"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "default": {
            "description": "See AGENT_PROTOCOL.md for error and retry behavior"
          }
        }
      }
    },
    "/api/agent/state": {
      "put": {
        "summary": "Report current observations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../internal/server/schemas/agent.json#/$defs/state"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "default": {
            "description": "See AGENT_PROTOCOL.md for error and retry behavior"
          }
        }
      }
    },
    "/api/agent/reports": {
      "post": {
        "summary": "Submit telemetry history",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../internal/server/schemas/agent.json#/$defs/reports"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "default": {
            "description": "See AGENT_PROTOCOL.md for error and retry behavior"
          }
        }
      }
    },
    "/api/agent/events": {
      "post": {
        "summary": "Submit events",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../internal/server/schemas/agent.json#/$defs/events"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "default": {
            "description": "See AGENT_PROTOCOL.md for error and retry behavior"
          }
        }
      }
    },
    "/api/agent/resources/{type}": {
      "put": {
        "summary": "Submit resource observations",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../internal/server/schemas/agent.json#/$defs/resources"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "default": {
            "description": "See AGENT_PROTOCOL.md for error and retry behavior"
          }
        }
      }
    },
    "/api/agent/commands": {
      "get": {
        "summary": "Poll for commands",
        "parameters": [
          {
            "name": "wait",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "default": {
            "description": "See AGENT_PROTOCOL.md for error and retry behavior"
          }
        }
      }
    },
    "/api/agent/commands/{id}/claim": {
      "post": {
        "summary": "Claim the one-time execution permit",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "default": {
            "description": "See AGENT_PROTOCOL.md for error and retry behavior"
          }
        }
      }
    },
    "/api/agent/commands/{id}/result": {
      "post": {
        "summary": "Record the execution outcome",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../internal/server/schemas/agent.json#/$defs/result"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "default": {
            "description": "See AGENT_PROTOCOL.md for error and retry behavior"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AgentBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Agent credential for session creation. Session Bearer for subsequent calls."
      }
    }
  }
}
