{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Id"
    },
    "label": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "name": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$",
      "title": "Name",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "type": {
      "const": "metric",
      "title": "Type",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "value": {
      "maxLength": 64,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "Value",
      "type": "string"
    }
  },
  "required": [
    "name",
    "value",
    "type",
    "schema_version",
    "observed_at"
  ],
  "title": "MetricPoint",
  "type": "object"
}
