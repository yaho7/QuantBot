{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "maxProperties": 12,
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "Arguments",
      "type": "object"
    },
    "request_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "revision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "revision",
    "request_id"
  ],
  "title": "ControlInvocation",
  "type": "object"
}
