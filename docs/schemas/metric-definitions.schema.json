{
  "$defs": {
    "MetricDefinition": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "description": {
          "default": "",
          "maxLength": 1000,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "default": "gauge",
          "enum": [
            "gauge",
            "counter",
            "ratio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "MetricDefinition",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricDefinition"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    }
  },
  "required": [
    "metrics"
  ],
  "title": "MetricDefinitions",
  "type": "object"
}
