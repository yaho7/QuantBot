{
  "name": "quantbot-web",
  "private": true,
  "version": "3.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:lyra",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "node --test tests/layout-defaults.test.mjs",
    "test:e2e": "playwright test",
    "build:lyra": "vite build --config theme-plugins/lyra/vite.config.ts && node scripts/package-lyra-theme.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/oxanium": "5.3.0",
    "@remixicon/react": "4.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.8.0",
    "shadcn": "4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
